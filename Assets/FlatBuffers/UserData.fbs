namespace BanpoFri.Data;


///// 자동 클래스 생성 규칙 /////
// @AutoCreate 주석 이후의 내용만 처리 (없으면 자동 처리 X)
// @EndCreate 주석 이후의 내용은 자동 처리 X
/* 예시)
// @AutoCreate
  data_1:int; // 자동 생성 O
  data_2:int; // 자동 생성 O
// @EndCreate
  data_3:int; // 자동 생성 X
  data_4:int; // 자동 생성 X
// @AutoCreate
  data_5:int; // 자동 생성 O
*/
// 기본 자료형의 경우 뒤에 // @ReactiveProperty 주석 값을 붙이면 ReactiveProperty 형으로 생성
// ex) testdata:[int] = 0; // @ReactiveCollection
// 뒤에 붙이는 자료형들
// @ReactiveProperty : ReactiveProperty 형
// @ReactiveCollection : ReactiveCollection 형
// @Dictionary : Dictionary 형
// [] 형태에서 뒤에 Dictionary 주석이 없으면 기본 List 형으로 생성됨
////////////////////////////

table UserData {
// @AutoCreate
  cash:int = 0;// @ReactiveProperty
  buyinappids:string;
  tutorial:[string];
  lastlogintime:long = 0;
  optiondata:OptionData;
  recordcount:[RecordCount];
  gamestarttime:long = 0;
  uuid:long = 0;
  recordvalue:[RecordCount];
  stageidx:int = 1;// @ReactiveProperty
  // @EndCreate
  money:string;
  // @AutoCreate
  waveidx:int = 0; // @ReactiveProperty
  vipticket:int =0; // @ReactiveProperty


  material:int = 0; // @ReactiveProperty
  // @AutoCreate
  resetdaytime:long = 0; //@DateTime

  // 슬라임 강화(훈련) 업그레이드 레벨. TrainingSystem 이 사용. 값/비용은 TrainingInfo 테이블에서 계산.
  trainingatk:int = 0; // @ReactiveProperty
  trainingatkspeed:int = 0; // @ReactiveProperty
  trainingcoin:int = 0; // @ReactiveProperty

  // @EndCreate
  // Reserved field IDs for saves written by the removed game.
  reserved18:ubyte (deprecated);
  reserved19:ubyte (deprecated);

  // @AutoCreate
  // SHOW BALL (바나나볼 래그돌 야구) 진행 데이터. 새 필드는 항상 이 아래(테이블 끝)에 추가
  showballdata:ShowBallData;
  // @EndCreate

}

table OptionData {
  language:string;
  bgm:bool = false;
  effect:bool = false;
  slowgraphic:bool = false;
  vibration:bool = true;
  subscribeorder:bool = false;
  autofelling:bool = false;
  difficultytype:int = 1;
}

table RecordCount {
  idx:string;
  count:int = 0;
}




table ItemData
{
   itemtype:int = 0;
   itemidx:int = 0; 
   itemcnt:int = 0;   // @ReactiveProperty
}

// SHOW BALL 진행 데이터 (Assets/BananaBall/SaveBridge/ShowBallSaveBridge.cs 에서 사용)
table ShowBallData {
  lineup:[int];        // 타순, Role 값 (0 파워, 1 콘택트, 2 주루)
  fans:int = 0;        // 누적 팬
  matches:int = 0;     // 끝까지 치른 경기 수
  lastvisitor:int = 0; // 지난 경기 선공 (0 기록 없음, 1 코럴, 2 청록)
  hints:[string];      // 이미 본 첫 안내 키
  matchlog:[string];   // 최근 경기 기록 (최대 20개)
}

root_type UserData;
